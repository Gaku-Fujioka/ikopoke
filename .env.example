# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional browser-only Maps key. Restrict websites AND allowed APIs in Google Cloud.
# Disabled until billing/quotas, key restrictions and public policies are reviewed.
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=false
NEXT_PUBLIC_GOOGLE_PLACES_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
